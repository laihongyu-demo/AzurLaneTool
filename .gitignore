# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 本地用户数据（每台机器独立，不入库）
data/user.json
# 回测运行记录与报告（本机用户数据，不入库；正式报告手工整理到 docs/）
data/efficiency_backtest.json
data/backtest/

# 本地活动统计源文件（已导入数据库，不入库；需要时用导入脚本 --csv 指定）
/event.csv

# IDE 配置
.vscode/
.idea/
*.swp
*.swo
.VSCodeCounter/

# 临时文件
*.log
*.tmp
*.bak

# 打包输出
build/
dist/
*.spec
# build.spec 是项目构建配置，必须跟踪；上面的 *.spec 只忽略临时/生成的 spec
!build.spec

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 虚拟环境
venv/
env/
.venv/

# DSH 插件开发目录（Harness 插件源码，本机开发用，不属于本项目）
dsh-plugins/
.dsh/
